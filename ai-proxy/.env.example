# ── AJO AI Proxy — environment template ──────────────────────────────────────
# Copy to .env and fill in your values.
# .env is git-ignored. This file IS committed as a reference.

PORT=3001
OLLAMA_BASE=http://localhost:11434
MODEL=llama3
CONCURRENCY=1

# debug | info | warn | error
LOG_LEVEL=info

# Uncomment to write JSON-lines log to file:
# LOG_FILE=./proxy.log

# Extra CORS origins (comma-separated):
# ALLOWED_ORIGINS=https://my-site.com

# LLM per-journey log files (one .log file per journey — Agent 1 + Agent 2 details):
# LLM_LOG_DIR=./llm-logs

# ── Adobe UPS API credentials (Agent 1 — Audience Resolver) ──────────────────
# Required for resolving audience definitions to plain English.
# The proxy calls the Adobe UPS API server-side (no CORS issues).
# Leave blank to disable audience resolution (scoring will still work).
ADOBE_TOKEN=
ADOBE_API_KEY=
ADOBE_ORG_ID=
ADOBE_SANDBOX=

# Adobe UPS API base URL (default — change for non-prod environments):
# ADOBE_UPS_BASE=https://platform.adobe.io/data/core/ups
